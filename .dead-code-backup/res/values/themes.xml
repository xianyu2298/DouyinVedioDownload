<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.VedioDownload" parent="Theme.Material3.Light.NoActionBar">
        <!-- 主题颜色 -->
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryDark">@color/primary_dark</item>
        <item name="colorPrimaryVariant">@color/primary_variant</item>
        <item name="colorSecondary">@color/secondary</item>
        <item name="colorSecondaryVariant">@color/secondary</item>

        <!-- 背景颜色 -->
        <item name="android:colorBackground">@color/background</item>
        <item name="colorSurface">@color/surface</item>

        <!-- 文字颜色 -->
        <item name="colorOnPrimary">@color/text_on_primary</item>
        <item name="colorOnSecondary">@color/text_primary</item>
        <item name="colorOnBackground">@color/text_primary</item>
        <item name="colorOnSurface">@color/text_primary</item>

        <!-- 状态栏 -->
        <item name="android:statusBarColor">@color/mist_teal_700</item>
        <item name="android:navigationBarColor">@color/background</item>
    </style>

    <!-- 全屏播放器主题 -->
    <style name="Theme.VedioDownload.Fullscreen" parent="Theme.VedioDownload">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowTranslucentStatus">true</item>
        <item name="android:windowTranslucentNavigation">true</item>
    </style>

    <!-- 解析按钮 -->
    <style name="ParseButton" parent="Widget.Material3.Button.TonalButton">
        <item name="backgroundTint">@color/mist_teal_500</item>
        <item name="android:textColor">@color/ink_100</item>
        <item name="cornerRadius">24dp</item>
        <item name="android:stateListAnimator">@animator/btn_scale_down</item>
    </style>

    <!-- 解析按钮（次要样式） -->
    <style name="ParseButton.Secondary" parent="Widget.Material3.Button.TextButton">
        <item name="android:textColor">@color/mist_teal_500</item>
        <item name="rippleColor">@color/primary_ripple_secondary</item>
    </style>

    <!-- 下载按钮 -->
    <style name="DownloadButton" parent="Widget.Material3.Button">
        <item name="android:textColor">@color/ink_100</item>
        <item name="backgroundTint">@color/mist_teal_500</item>
        <item name="cornerRadius">16dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">10dp</item>
        <item name="android:stateListAnimator">@animator/btn_scale_down</item>
    </style>

    <!-- 输入框样式 -->
    <style name="UrlEditText" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">24dp</item>
        <item name="boxCornerRadiusTopEnd">24dp</item>
        <item name="boxCornerRadiusBottomStart">24dp</item>
        <item name="boxCornerRadiusBottomEnd">24dp</item>
        <item name="boxStrokeColor">@color/primary</item>
        <item name="hintTextColor">@color/text_hint</item>
    </style>

</resources>
